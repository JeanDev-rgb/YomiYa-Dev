<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="YomiYa.Features.Ads.BannerAdView"
             HorizontalAlignment="Stretch">
    <Grid x:Name="BannerHost" RowDefinitions="Auto,Auto,50" Margin="0,8">
        <TextBlock x:Name="DisclosureLabel" FontSize="10"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <Viewbox Grid.Row="1"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Top"
                 Stretch="Uniform"
                 StretchDirection="DownOnly">
            <NativeWebView x:Name="WideBannerWebView"
                           Width="728"
                           Height="90"
                           EnvironmentRequested="OnEnvironmentRequested" />
        </Viewbox>
        <NativeWebView x:Name="CompactBannerWebView" Grid.Row="2"
                       HorizontalAlignment="Stretch"
                       EnvironmentRequested="OnEnvironmentRequested" />
    </Grid>
</UserControl>
