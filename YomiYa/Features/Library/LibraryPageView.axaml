<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:library="clr-namespace:YomiYa.Features.Library"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="library:LibraryPageViewModel"
             x:Class="YomiYa.Features.Library.LibraryPageView">

    <Design.DataContext>
        <library:LibraryPageViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="TextBlock.PageTitle">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Margin" Value="0 0 0 20" />
        </Style>

        <Style Selector="Button.MangaCard">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="RenderTransform" Value="scale(1.0)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0.15" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.MangaCard /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.MangaCard:pointerover">
            <Setter Property="RenderTransform" Value="scale(1.02)" />
        </Style>

        <Style Selector="Button.MangaCard:pointerover /template/ ContentPresenter">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
        </Style>

        <Style Selector="Button.MangaCard:pressed">
            <Setter Property="RenderTransform" Value="scale(0.99)" />
        </Style>

        <Style Selector="Border.TitleOverlay">
            <Setter Property="Background" Value="#90000000" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Height" Value="100" />
        </Style>

        <Style Selector="TextBlock.MangaTitle">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="12" />
        </Style>

        <Style Selector="TextBlock.Kamoji">
            <Setter Property="FontSize" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.NoItemsMessage">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0 20 0 0" />
        </Style>

        <Style Selector="Button.DeleteButton">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ZIndex" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0.15" />
                    <BrushTransition Property="Foreground" Duration="0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.DeleteButton:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorErrorBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </UserControl.Styles>

    <Border Background="{DynamicResource ApplicationPageBackgroundThemeBrush}" Padding="32">
        <Grid RowDefinitions="Auto,Auto,*">
            <TextBlock Grid.Row="0" Classes="PageTitle" Text="{Binding Title}" />
            <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,0,0,16" ColumnSpacing="8">
                <TextBox Grid.Column="0" Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Buscar en la biblioteca"
                         MinHeight="40" VerticalContentAlignment="Center" />
                <ToggleButton Grid.Column="1" Content="Z–A" IsChecked="{Binding SortDescending}" ToolTip.Tip="Cambiar orden alfabético" />
                <CheckBox Grid.Column="2" Content="No leídos" IsChecked="{Binding UnreadOnly}" VerticalAlignment="Center" />
                <ToggleButton Grid.Column="3" Content="Lista" IsChecked="{Binding IsListView}" ToolTip.Tip="Alternar cuadrícula y lista" />
            </Grid>

            <ScrollViewer Grid.Row="2">
                <Grid>
                <ItemsControl HorizontalAlignment="Stretch" VerticalAlignment="Top" ItemsSource="{Binding Mangas}"
                              IsVisible="{Binding IsGridView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="450">
                                <Button Classes="MangaCard"
                                        HorizontalAlignment="Stretch"
                                        Command="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).OpenMangaCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        <Border Classes="TitleOverlay" Height="130" />
                                        <StackPanel VerticalAlignment="Bottom" Margin="12" Spacing="5">
                                            <TextBlock Classes="MangaTitle" Margin="0" Text="{Binding Title}" />
                                            <TextBlock Text="{Binding LastReadChapterName}" Foreground="White" FontSize="12"
                                                       TextTrimming="CharacterEllipsis" />
                                            <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadProgress}" Height="4" />
                                        </StackPanel>
                                    </Grid>
                                </Button>

                                <Button Classes="DeleteButton"
                                        ToolTip.Tip="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).DeleteFromLibraryButtonText}"
                                        Command="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).DeleteMangaCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Data="{StaticResource TrashIcon}" Width="16" Height="16" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid VerticalAlignment="Top"
                                         Columns="{Binding DisplayColumns}"
                                         ColumnSpacing="20"
                                         RowSpacing="20" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <ItemsControl HorizontalAlignment="Stretch" VerticalAlignment="Top" ItemsSource="{Binding Mangas}"
                              IsVisible="{Binding IsListView}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                                    Margin="0,0,0,8" Padding="8">
                                <Grid ColumnDefinitions="96,*,Auto" Height="132" ColumnSpacing="14">
                                    <Image Grid.Column="0" Source="{Binding Cover}" Stretch="UniformToFill" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="7">
                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LastReadChapterName}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ProgressBar Minimum="0" Maximum="1" Value="{Binding ReadProgress}" Height="5" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="6">
                                        <Button Content="Continuar" Command="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).ContinueReadingCommand}" CommandParameter="{Binding}" />
                                        <Button Content="Obra" Command="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).OpenMangaCommand}" CommandParameter="{Binding}" />
                                        <Button Content="Quitar" Command="{Binding $parent[UserControl].((library:LibraryPageViewModel)DataContext).DeleteMangaCommand}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </Grid>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        VerticalAlignment="Center"
                        IsVisible="{Binding Mangas.Count, Converter={StaticResource ZeroToVisibleConverter}}"
                        HorizontalAlignment="Center"
                        Spacing="10">
                <TextBlock Classes="Kamoji" Text="{Binding RandomKamoji}" IsVisible="{Binding IsLibraryEmpty}" />
                <TextBlock Classes="NoItemsMessage" Text="{Binding EmptyMessage}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
