<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:store="clr-namespace:YomiYa.Features.Store"
             mc:Ignorable="d" d:DesignWidth="1080" d:DesignHeight="700"
             x:DataType="store:StorePageViewModel"
             x:Class="YomiYa.Features.Store.StorePageView">

    <Design.DataContext>
        <store:StorePageViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">

        <!-- Barra superior -->
        <Border Grid.Row="0"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Padding="16,10"
                CornerRadius="0,0,8,8">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <PathIcon Width="20" Data="{StaticResource ShoppingCart}"
                              Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding StoreTitleText}"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        <TextBlock Text="{Binding StoreSubtitleText}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Command="{Binding RefreshCommand}"
                        Content="{Binding RefreshText}"
                        Margin="0,0,8,0"
                        Padding="12,6"
                        CornerRadius="6"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                <Button Grid.Column="2" Command="{Binding OpenInBrowserCommand}"
                        Content="{Binding OpenInBrowserText}"
                        Padding="12,6"
                        CornerRadius="6"
                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                        Foreground="White" />
            </Grid>
        </Border>

        <!-- WebView -->
        <NativeWebView Grid.Row="1"
                        x:Name="WebView"
                        Source="{Binding StoreSource}" />

        <!-- Indicador de carga -->
        <Border Grid.Row="1"
                Background="#80000000"
                IsVisible="{Binding IsLoading}"
                IsHitTestVisible="False"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressBar IsIndeterminate="True" Width="200" />
                <TextBlock Text="{Binding LoadingText}"
                           Foreground="White" FontSize="14"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
