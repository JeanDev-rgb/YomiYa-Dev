@'
# ==========================================
# Compilación y Binarios (.NET 10 / C#)
# ==========================================
**/bin/
**/obj/
*.dll
*.exe
*.pdb
*.cache
*.deps.json
*.runtimeconfig.json

**/runtimes/

# ==========================================
# IDEs y Configuración Local
# ==========================================
.idea/
.vs/
*.DotSettings.user
*.suo
*.user
tree.txt

# ==========================================
# WebView2 / Engine Cache
# ==========================================
**/EBWebView/
**/*.WebView2/

# ==========================================
# Caché de Aplicación, Datos e Imágenes
# ==========================================
**/Cache/
**/ImageCache/
**/Data/*.db
**/Data/*.sqlite
*.db
*.sqlite
**/token

# ==========================================
# Archivos Sensibles y Credenciales
# ==========================================
credentials.json
secrets.json
*.env
*.env.local
appsettings.*.json
!appsettings.json

# ==========================================
# Assets Binarios
# ==========================================
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.ico
*.ttf
*.woff
*.woff2
'@ | Set-Content -Path .claudeignore, .aiignore -Encoding UTF8